{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "PI_HARNESS_TEST", "class_name": "PiHarnessTestObject" },
      { "name": "PiSessionIndex", "class_name": "PiSessionIndex" },
      { "name": "PiSettings", "class_name": "PiSettings" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PiHarnessTestObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PiSessionIndex"] },
    { "tag": "v3", "new_sqlite_classes": ["PiSettings"] }
  ]
}
