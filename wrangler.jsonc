{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pi-harness",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // ==========================================================================
  // 保留 Dashboard 里设置的环境变量（CF_ACCOUNT_ID 等）。
  // 不加这一行，每次 wrangler deploy 都会把 Dashboard 里的普通变量清空，
  // 只有 Secret 类型会保留。官方说明：Wrangler 配置 "Source of truth" 一节。
  // ==========================================================================
  "keep_vars": true,
  "ai": { "binding": "AI", "remote": true },
  // 发布/分享文件的桶（publish 工具、Files 面板分享）。mount/ 前缀会只读
  // 挂到每个工作区的 /workspace/r2。
  "r2_buckets": [{ "binding": "PI_FILES", "bucket_name": "pi-files" }],
  // `exec` runs JavaScript in Dynamic Workers minted through this.
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "not_found_handling": "single-page-application",
    // 这些路径走 Worker，其余都是前端静态页面（SPA 兜底）。
    // 新加服务端路由记得补这里，否则会被前端页面接管。
    "run_worker_first": ["/api/*", "/agents/*", "/share/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PiAgent",
        "class_name": "PiAgent"
      },
      {
        // 会话目录（每个用户一个实例），见 src/sessions.ts
        "name": "PiSessionIndex",
        "class_name": "PiSessionIndex"
      }
    ]
  },
  // 命名规则：所有组件（Worker、DO 类、绑定）以 pi 开头。
  // 迁移只能追加，不能改历史条目：v2 建了 SessionIndex，v3 把它改名。
  // 不管 v2 有没有部署过，wrangler 都会按顺序补齐到 v3。
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PiAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SessionIndex"]
    },
    {
      "tag": "v3",
      "renamed_classes": [{ "from": "SessionIndex", "to": "PiSessionIndex" }]
    }
  ],
  "observability": {
    "enabled": true
  }
}
